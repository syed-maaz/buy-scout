# Copy this file to .env. The app loads .env at startup; shell exports win.
# Storage
DB_PATH=./data/buy-scout.db
RAW_DIR=./data/raw

# POC search brief
SEARCH_ZIP=69168
SEARCH_RADIUS_KM=200
PURCHASE_MAX_EUR=7000
RESERVE_EUR=800

# Fetch behaviour
FETCH_DELAY_MS=3000
FETCH_REFRESH_PAGES=10
FETCH_MIN_PAGES=5
FETCH_TARGET_NEW=50
FETCH_AVAILABILITY_LIMIT=12
FETCH_AVAILABILITY_HOURS=24
AVAILABILITY_LIMIT=100
AVAILABILITY_DELAY_MS=2000
UI_PORT=8124

# Laya local triage (default on; set to 0 to disable)
LAYA_ENABLED=1
LAYA_SUBFOLDER=
LAYA_CACHE=./.cache/laya

# Optional: OpenAI-compatible LLM analysis. LLM_* wins over legacy DEEPSEEK_*.
# Providers: deepseek | openai | openrouter | ollama | custom
LLM_PROVIDER=deepseek
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_JSON_MODE=1
LLM_ALLOW_NO_KEY=0

# Legacy DeepSeek names remain supported when LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-v4.1-flash

# Optional: Firecrawl web search for deep research
FIRECRAWL_API_KEY=
